# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saferstreets?schema=public"

# Auth & Secrets
SESSION_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
OTP_HMAC_SECRET="replace-with-a-secure-random-hmac-secret-at-least-32-chars"

# Email Delivery (Resend)
RESEND_API_KEY="re_sample_key_here"

# Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Map & Geocoding (MapTiler)
MAPTILER_KEY="your_maptiler_api_key"

# Application URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
